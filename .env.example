# App
ENVIRONMENT=development
DEBUG=true

# Auth
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Database
DATABASE_URL=postgresql://localhost:5432/rufus_generator

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Sentry
SENTRY_DSN=

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# Google Sheets (path to service account JSON)
GOOGLE_SERVICE_ACCOUNT_PATH=./config/google-service-account.json

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10737418240

# AWS S3 (optional — set AWS_S3_BUCKET to enable S3 storage instead of local disk)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
